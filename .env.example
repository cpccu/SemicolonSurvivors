# Copy to .env.local; blank values keep backend workflows unavailable.
# Use the project's public publishable key, never a secret or service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Direct/pooler database URL for the one-time reviewed migration command.
# Keep this blank until you copy it locally from Supabase Connect.
SUPABASE_DB_URL=

# Privileged integration is optional and server-only; no elevated client is enabled.
SUPABASE_SECRET_KEY=

# AI remains disabled by default. A local demo must explicitly attest provider privacy/quota
# readiness and opt into each source-grounded workflow.
CAMPUS_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash
CAMPUS_AI_PRIVACY_REVIEWED=false
CAMPUS_AI_QUOTA_VERIFIED=false
CAMPUS_AI_HELPDESK_ENABLED=false
CAMPUS_AI_RESOURCE_SUMMARIES_ENABLED=false

# Replace with the exact deployed HTTPS origin in production.
CAMPUS_SITE_URL=http://localhost:3000/
# Configure the institution UUID used in approved scoped staff assignments.
CAMPUS_INSTITUTION_ID=
CAMPUS_AUTH_EMAIL_ENABLED=false
CAMPUS_SMTP_VERIFIED=false
